{
  "name": "@postern/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/index.js",
    "start": "node --env-file-if-exists=../.env src/index.js",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=../.env src/db/migrate.js",
    "db:seed": "node --env-file-if-exists=../.env src/db/seed.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "chrono-node": "^2.10.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^5.0.5"
  }
}
